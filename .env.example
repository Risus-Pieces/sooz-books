# Sooz Books — local environment
# Supabase project: sooz-books (rufzfaecfhrlnnhvsfyv), region us-west-1

# Session-mode pooler: supports multi-statement transactions and prepared statements.
DATABASE_URL="postgresql://sooz_app.rufzfaecfhrlnnhvsfyv:YOUR_DB_PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL="https://rufzfaecfhrlnnhvsfyv.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable__Ul20_cFnuPbRDdXaBLKwA_M6D79zF0"

# Server-only. Creates the account behind an invitation link, so a new teammate never needs an
# email to get in. Anyone holding it can act as any user: never ship it to the browser, never
# commit it, and set it in Vercel as a secret rather than a plain variable.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Optional: AI-assisted bank transaction categorization.
# Set one of these; without either, the review queue falls back to rules only.
# AI_GATEWAY_API_KEY=""
# ANTHROPIC_API_KEY=""
AI_SUGGEST_MODEL="anthropic/claude-haiku-4-5"
# The model that reads receipts in the Assistant (default: anthropic/claude-sonnet-5). Uses the same
# key as above. Without a key, a receipt is still stored and you fill it in by hand.
# AI_RECEIPT_MODEL="anthropic/claude-sonnet-5"

# The end-to-end suite signs in as a real Supabase identity, because that is where identities
# live. The account is switched off in production, so it can sign in to a local replica only.
E2E_EMAIL="e2e@sooz-books.invalid"
E2E_PASSWORD="YOUR_E2E_PASSWORD"
