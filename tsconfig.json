{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next/e2e/types/**/*.ts",
    ".next/e2e/dev/types/**/*.ts",
    ".next/arap/types/**/*.ts",
    ".next/arap/dev/types/**/*.ts",
    ".next/banking/types/**/*.ts",
    ".next/banking/dev/types/**/*.ts",
    ".next/channels-trade/types/**/*.ts",
    ".next/channels-trade/dev/types/**/*.ts",
    ".next/inventory-plan/types/**/*.ts",
    ".next/inventory-plan/dev/types/**/*.ts",
    ".next/books/types/**/*.ts",
    ".next/books/dev/types/**/*.ts",
    ".next/settings-states/types/**/*.ts",
    ".next/settings-states/dev/types/**/*.ts",
    ".next/settings-states-build/types/**/*.ts",
    ".next/settings-states-build/dev/types/**/*.ts",
    ".next/integrate/types/**/*.ts",
    ".next/integrate/dev/types/**/*.ts",
    ".next/integrate-build/types/**/*.ts",
    ".next/integrate-build/dev/types/**/*.ts",
    ".next/judge3152/types/**/*.ts",
    ".next/judge3152/dev/types/**/*.ts",
    ".next/hig-review/types/**/*.ts",
    ".next/hig-review/dev/types/**/*.ts",
    ".next/fixes/types/**/*.ts",
    ".next/fixes/dev/types/**/*.ts",
    ".next/fixes-build/types/**/*.ts",
    ".next/fixes-build/dev/types/**/*.ts",
    ".next/review/types/**/*.ts",
    ".next/review/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
